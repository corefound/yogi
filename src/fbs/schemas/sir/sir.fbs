// sir/sir.fbs

include "common.fbs";
include "constants.fbs";
include "externs.fbs";

namespace Yogi.Sir;

enum SemanticDecisionKind:byte {
  Unknown = 0,
  Copy,
  Move,
  Borrow,
  Escape,
  Storage,
  Materialize,
  Promote
}

enum SemanticDecisionReason:byte {
  Unknown = 0,
  TrivialValueCopy,
  ExplicitArrayCopy,
  CopyingArrayMethod,
  ResourceOwningInitialization,
  ResourceOwningAssignment,
  ReturnTransfersToCaller,
  ValueParameterConsumes,
  AddressOfBorrow,
  DerivedViewBorrow,
  KnownCalleeBorrow,
  UnknownExternalConservativeEscape,
  DeclaredValueEscapes,
  StackStorage,
  HeapStorage,
  GlobalStorage,
  BorrowedViewMaterialization,
  BorrowedViewOwnerPromotion,
  EscapeRequiresHeap
}

table ValueIdentity {
  value_id:string;
  origin_node_id:string;
  symbol_id:string;
  scope_id:string;
  type_id:string;
  source:string;
  position:SourcePosition;
}

table SemanticDecision {
  decision_id:string;
  node_id:string;
  value_id:string;
  type_id:string;
  kind:SemanticDecisionKind = Unknown;
  reason:SemanticDecisionReason = Unknown;
  context:string;
  related_ids:[string];
  runtime_required:bool = false;
  source:string;
  position:SourcePosition;
}

table IdentifierExpression {
  name:string;
  type:TypeRef;
  symbol_id:int = -1;
  scope_id:int = -1;
  linkage_name:string;
  qualified_name:string;
  source:string;
  position:SourcePosition;
}

table ValueRef {
  node_id:string;
  value_id:string;
  type_id:string;
  decision_ids:[string];
  kind:string;
  constant:Constant;
  identifier:IdentifierExpression;
  binary:BinaryExpression;
  assignment:AssignmentExpression;
  conditional:ConditionalExpression;
  call:CallExpression;
  spread:SpreadElement;
  array:ArrayExpression;
  object:ObjectExpression;
  property_access:PropertyAccessExpression;
  element_access:ElementAccessExpression;
  address_of:AddressOfExpression;
  dereference:DereferenceExpression;
  aggregate_assignment:AggregateAssignmentExpression;
  function_expression:FunctionExpression;
}

table BinaryExpression {
  operator:string;
  left:ValueRef;
  right:ValueRef;
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table AssignmentExpression {
  left:IdentifierExpression;
  right:ValueRef;
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table ConditionalExpression {
  condition:ValueRef;
  when_true:ValueRef;
  when_false:ValueRef;
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table CallExpression {
  callee:ValueRef;
  arguments:[ValueRef];
  argument_effects:[CallArgumentEffect];
  type:TypeRef;
  symbol_id:int = -1;
  linkage_name:string;
  qualified_name:string;
  external:bool = false;
  /// Built-in method identifier for array methods (e.g., "array.push", "array.pop", "array.at")
  builtin_method:string;
  source:string;
  position:SourcePosition;
}

table CallArgumentEffect {
  index:int = -1;
  escapes:bool = false;
  mutates:bool = false;
  consumes:bool = false;
}

table SpreadElement {
  expression:ValueRef;
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table ArrayExpression {
  elements:[ValueRef];
  type:TypeRef;
  source:string;
  position:SourcePosition;
  storage_mode:string;
}

table ObjectProperty {
  key:string;
  value:ValueRef;
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table ObjectExpression {
  properties:[ObjectProperty];
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table PropertyAccessExpression {
  object:ValueRef;
  property:string;
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table ElementAccessExpression {
  object:ValueRef;
  index:ValueRef;
  indices:[ValueRef];
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table AddressOfExpression {
  target:ValueRef;
  type:TypeRef;
  source:string;
  position:SourcePosition;
  root_symbol_id:int = -1;
  root_name:string;
  access_path:[string];
  permission:string;
}

table DereferenceExpression {
  target:ValueRef;
  type:TypeRef;
  source:string;
  position:SourcePosition;
  root_symbol_id:int = -1;
  root_name:string;
  access_path:[string];
  permission:string;
}

table AggregateAssignmentExpression {
  target:ValueRef;
  right:ValueRef;
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table VariableDeclaration {
  name:string;
  type:TypeRef;
  value:ValueRef;
  symbol_id:int = -1;
  scope_id:int = -1;
  mutable:bool = false;
  storage:string;
  flag:string;
  exported:bool = false;
  trusted:bool = true;
  escapes:bool = false;
  linkage_name:string;
  qualified_name:string;
  source:string;
  position:SourcePosition;
}

/// Array declaration with inline element initializers.
/// Represents: let name: type[] = [elem1, elem2, ...]
table ArrayDeclaration {
  name:string;
  type:TypeRef;
  elements:[ValueRef];
  symbol_id:int = -1;
  scope_id:int = -1;
  mutable:bool = false;
  storage:string;
  flag:string;
  exported:bool = false;
  trusted:bool = true;
  escapes:bool = false;
  linkage_name:string;
  qualified_name:string;
  source:string;
  position:SourcePosition;
}

table ReturnStatement {
  value:ValueRef;
  source:string;
  position:SourcePosition;
}

table BlockStatement {
  statements:[SirNode];
  source:string;
  position:SourcePosition;
}

table IfStatement {
  condition:ValueRef;
  then_block:BlockStatement;
  else_block:BlockStatement;
  source:string;
  position:SourcePosition;
}

table WhileStatement {
  condition:ValueRef;
  body:BlockStatement;
  source:string;
  position:SourcePosition;
}

table ForStatement {
  initializer:SirNode;
  condition:ValueRef;
  incrementor:ValueRef;
  body:BlockStatement;
  source:string;
  position:SourcePosition;
}

table BreakStatement {
  source:string;
  position:SourcePosition;
}

table ContinueStatement {
  source:string;
  position:SourcePosition;
}

table CaseClause {
  expression:ValueRef;
  body:BlockStatement;
  source:string;
  position:SourcePosition;
}

table DefaultClause {
  body:BlockStatement;
  source:string;
  position:SourcePosition;
}

table SwitchStatement {
  expression:ValueRef;
  clauses:[SirNode];
  source:string;
  position:SourcePosition;
}

table FunctionParameter {
  name:string;
  type:TypeRef;
  symbol_id:int = -1;
  scope_id:int = -1;
  mutable:bool = true;
  storage:string;
  trusted:bool = true;
  source:string;
  position:SourcePosition;
}

table ParameterEffect {
  index:int = -1;
  returns:bool = false;
  stores:bool = false;
  escapes:bool = false;
  mutates:bool = false;
  consumes:bool = false;
}

table ReturnBorrowSummary {
  ownership:string;
  parameter_index:int = -1;
  readonly_follows_parameter:bool = false;
  view_shape:[int];
}

table FunctionEffectSummary {
  parameter_effects:[ParameterEffect];
  returns_aggregate:bool = false;
  return_borrow:ReturnBorrowSummary;
}

table FunctionDeclaration {
  name:string;
  parameters:[FunctionParameter];
  return_type:TypeRef;
  body:BlockStatement;
  symbol_id:int = -1;
  scope_id:int = -1;
  mutable:bool = false;
  flag:string;
  exported:bool = false;
  trusted:bool = true;
  linkage_name:string;
  qualified_name:string;
  source:string;
  position:SourcePosition;
  effect_summary:FunctionEffectSummary;
}

table FunctionExpression {
  callback_name:string;
  parameters:[FunctionParameter];
  return_type:TypeRef;
  body:BlockStatement;
  type:TypeRef;
  source:string;
  position:SourcePosition;
  effect_summary:FunctionEffectSummary;
}

table LayoutMetadata {
  pointer:bool = false;
  mutable:bool = false;
  nullable:bool = false;
  bits:int = 0;
  signed:bool = false;
  align:int = 0;
  packed:bool = false;
  encoding:string;
  storage:string;
  max_length:int = 0;
  null_terminated:bool = false;
}

table StructFieldDeclaration {
  name:string;
  type:TypeRef;
  source:string;
  position:SourcePosition;
}

table StructDeclaration {
  name:string;
  type_parameters:[TypeRef];
  extends:TypeRef;
  fields:[StructFieldDeclaration];
  has_layout:bool = false;
  layout:LayoutMetadata;
  has_validate:bool = false;
  validate_chain:[string];
  is_scalar:bool = false;
  exported:bool = false;
  symbol_id:int = -1;
  scope_id:int = -1;
  linkage_name:string;
  qualified_name:string;
  source:string;
  position:SourcePosition;
}

union SirNodeValue {
  Constant,
  ExternDeclaration,
  IdentifierExpression,
  BinaryExpression,
  AssignmentExpression,
  ConditionalExpression,
  CallExpression,
  ArrayExpression,
  ObjectExpression,
  PropertyAccessExpression,
  ElementAccessExpression,
  AggregateAssignmentExpression,
  VariableDeclaration,
  ReturnStatement,
  BlockStatement,
  IfStatement,
  WhileStatement,
  ForStatement,
  BreakStatement,
  ContinueStatement,
  CaseClause,
  DefaultClause,
  SwitchStatement,
  FunctionDeclaration,
  ArrayDeclaration,
  StructDeclaration
}

table SirNode {
  node_id:string;
  decision_ids:[string];
  value:SirNodeValue;
}

table Module {
  module_id:string;
  source_path:string;
  nodes:[SirNode];
  values:[ValueIdentity];
  decisions:[SemanticDecision];
}

root_type Module;
